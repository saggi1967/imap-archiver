# IMAP-Verbindung zum Firmenserver
IMAP_HOST=mail.firma.example
IMAP_PORT=993
IMAP_SSL=true
# Zertifikatsprüfung. Bei bekanntem Hostname-Mismatch bewusst auf false setzen.
IMAP_SSL_VERIFY=true
IMAP_USER=benutzer@firma.example
IMAP_PASSWORD=
# Komma-getrennte Ordnerliste (Default: nur INBOX)
IMAP_FOLDERS=INBOX

# Lokale SQLite-Datei
DB_PATH=mailarc.db

# Elasticsearch (prod_stack)
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=
ES_INDEX=emails
# Nur bei https: auf false setzen, um Zertifikatsprüfung zu deaktivieren
ES_VERIFY_CERTS=true
